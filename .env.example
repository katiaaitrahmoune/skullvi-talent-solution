# --- Server ---
PORT=4000
NODE_ENV=development
# The Next.js frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# --- Database (docker compose up -d starts this one) ---
DATABASE_URL=postgres://skullvi:skullvi@localhost:5432/talent_engine
# Neon: paste its connection string instead, e.g.
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Use the POOLED string (host contains "-pooler") for the app. For `npm run db:migrate` / `db:seed`
# you may prefer the DIRECT string (without "-pooler"). If the connection fails mentioning
# channel_binding, remove "&channel_binding=require" from the URL.

# --- Auth ---
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Used once by `npm run db:seed` to create the first admin
ADMIN_EMAIL=admin@skullvi.org
ADMIN_PASSWORD=change-this-password-now

# --- Files (CVs and proofs uploaded by candidates) ---
UPLOAD_DIR=./uploads

# --- Scoring ---
# Points either side of a tier threshold that raise the "borderline" flag
BORDERLINE_MARGIN=3
# Optional override of the tier thresholds, e.g. [{"tier":"A","min":80},{"tier":"B","min":60},{"tier":"C","min":40},{"tier":"D","min":0}]
TIERS_JSON=

# --- AI top 3 (optional: without a key the system always uses the fallback) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=20000
# Which score picks the top 10 sent to the model: "deterministic" (as in the diagram) or "effective" (includes reviewer adjustments)
AI_SELECT_BY=deterministic
